  "query": "\n        UPDATE teams\n        SET \n            name = COALESCE($1, name),\n            number = COALESCE($2, number),\n            participants = COALESCE($3, participants),\n            updated_at = NOW()\n        WHERE id = $4 AND deleted_at IS NULL\n        RETURNING id, name, number, participants, created_at, updated_at\n        ",
