  "query": "\n        INSERT INTO team_ratings (team_id, checkpoint_id, rating)\n        VALUES ($1, $2, $3)\n        ON CONFLICT (checkpoint_id, team_id) DO UPDATE\n        SET \n            rating = EXCLUDED.rating,\n            updated_at = NOW(),\n            deleted_at = NULL\n        RETURNING id, team_id, checkpoint_id, rating, created_at, updated_at\n        ",
